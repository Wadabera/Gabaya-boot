# ========================================================
# GEBEYA BOOT / TELEGRAM SHOP AI ASSISTANT - ENV TEMPLATE
# ========================================================

# General Node Environment
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (PostgreSQL)
# Local development default using docker or local postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/gebeya_boot?schema=public

# Redis Configuration (Optional in development, falls back to in-memory)
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# JWT Secrets for Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-for-gebeya-boot
JWT_EXPIRATION=7d
ADMIN_JWT_SECRET=admin-super-secret-jwt-key-replace-in-production
ADMIN_JWT_EXPIRATION=1d

# Telegram Bot API Configuration
# Obtain token from @BotFather in Telegram
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_example
TELEGRAM_BOT_USERNAME=GebeyaShopBot
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=random-webhook-secret-string-32-chars

# AI Assistant Service
# Provider can be: mock, gemini, openai, groq
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# SMS Provider Configuration (For merchant phone verification)
# Provider can be: mock, afromessage
SMS_PROVIDER=mock
AFROMESSAGE_API_KEY=
AFROMESSAGE_SENDER_ID=

# File Storage Configuration
# Adapter can be: local, s3
STORAGE_ADAPTER=local
UPLOAD_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:3000/uploads

# Platform Defaults & Admin Initial Account
ADMIN_INITIAL_EMAIL=admin@gebeya-boot.et
ADMIN_INITIAL_PASSWORD=AdminGebeya2026!Secure
ADMIN_INITIAL_PHONE=+251911000000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_BOT_USERNAME=GebeyaShopBot
